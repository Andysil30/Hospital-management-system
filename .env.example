# Copy this file to ".env" and fill in your own values.
PORT=3000
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://hospital_user:hospital_pass@localhost:5432/hospital_db
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Hospital's local time zone (affects "today", daily revenue buckets, slots)
TIMEZONE=Africa/Nairobi
# Set to "production" when deployed behind HTTPS
NODE_ENV=development

# Optional: shown by the assistant bot when people ask for contacts / hours
HOSPITAL_PHONE=
HOSPITAL_ADDRESS=
HOSPITAL_HOURS=Mon-Fri 8:00-17:00, Sat 9:00-12:00

# Cloud database only: set to true if your DATABASE_URL host contains "-pooler"
# DB_POOLED=false
